{
  "$schema": "https://anthropic.com/claude-code/marketplace.schema.json",
  "name": "user-marketplace",
  "owner": {
    "name": "Timothy Liao",
    "email": "tim80411@gmail.com"
  },
  "metadata": {
    "description": "Custom marketplace for Timothy Liao's development tools including Adobe Animate/CreateJS and xAPI learning analytics",
    "version": "1.0.0"
  },
  "plugins": [
    {
      "name": "xapi-engineer",
      "source": "./plugins/xapi-engineer",
      "description": "xAPI statement generation and validation expert for educational assessment tracking",
      "version": "1.0.0",
      "author": {
        "name": "Timothy Liao",
        "email": "tim80411@gmail.com"
      },
      "repository": "https://github.com/tim80411/ai-agent-extension",
      "license": "MIT",
      "category": "development",
      "keywords": ["xapi", "tincan", "lrs", "learning-analytics", "cmi5", "scorm"],
      "strict": false
    },
    {
      "name": "design-toolkit",
      "source": "./plugins/design-toolkit",
      "description": "設計工具集：目前收錄 figma-read（透過連結讀取 Figma 設計稿，抽取結構化版面摘要，最小化 context 用量）",
      "version": "0.1.0",
      "author": {
        "name": "Timothy Liao",
        "email": "tim80411@gmail.com"
      },
      "repository": "https://github.com/tim80411/ai-agent-extension",
      "license": "MIT",
      "category": "design",
      "keywords": ["design", "figma", "ui-layout", "context-optimization"],
      "strict": false
    },
    {
      "name": "review-toolkit",
      "source": "./plugins/review-toolkit",
      "description": "驗證／審查工具集：code-quality-review（六維度平行程式碼品質審查）＋ copy-verify（使用者文案對術語 SSOT 的驗證與對齊，含禁用詞守衛）",
      "version": "0.2.0",
      "author": {
        "name": "Timothy Liao",
        "email": "tim80411@gmail.com"
      },
      "repository": "https://github.com/tim80411/ai-agent-extension",
      "license": "MIT",
      "category": "development",
      "keywords": ["code-review", "quality", "readability", "testability", "modularity", "copy", "microcopy", "glossary", "terminology", "文案", "禁用詞"],
      "strict": false
