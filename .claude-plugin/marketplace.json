    {
      "name": "book-study",
      "source": "./plugins/book-study",
      "description": "讀書會學習流程工具 — 從原文產生筆記、比對增補、Q&A 調查、導讀建議、Notion 發布",
      "version": "0.4.0",
      "author": {
        "name": "Timothy Liao",
        "email": "tim80411@gmail.com"
      },
      "repository": "https://github.com/tim80411/ai-agent-extension",
      "license": "MIT",
      "category": "learning",
      "keywords": ["book-study", "reading-group", "notes", "learning"],
      "strict": false
    },
    {
      "name": "tunnelbox-cli",
      "source": "./plugins/tunnelbox-cli",
      "description": "TunnelBox CLI usage guide — manage local static sites, servers, and Cloudflare tunnels via the tunnelbox command",
      "version": "0.1.0",
      "author": {
        "name": "Timothy Liao",
        "email": "tim80411@gmail.com"
      },
      "repository": "https://github.com/tim80411/ai-agent-extension",
      "license": "MIT",
      "category": "development",
      "keywords": ["tunnelbox", "cli", "static-site", "local-server", "cloudflare-tunnel"],
      "strict": false
    },
    {
      "name": "marketing-toolkit",
      "source": "./plugins/marketing-toolkit",
      "description": "行銷工具集：目前收錄 add-seo-ga（在 HTML <head> 加入完整 SEO 標籤結構與 Google Analytics 追蹤碼）",
      "version": "1.0.0",
      "author": {
        "name": "Timothy Liao",
        "email": "tim80411@gmail.com"
      },
      "repository": "https://github.com/tim80411/ai-agent-extension",
      "license": "MIT",
      "category": "marketing",
      "keywords": ["marketing", "seo", "meta-tags", "open-graph", "google-analytics", "gtag", "html"],
      "strict": false
    },
    {
      "name": "data-converter",
      "source": "./plugins/data-converter",
      "description": "資料轉換工具箱，收納各種格式互轉的 skill",
      "version": "1.5.1",
      "author": {
        "name": "Timothy Liao",
        "email": "tim80411@gmail.com"
      },
      "repository": "https://github.com/tim80411/ai-agent-extension",
      "license": "MIT",
      "category": "development",
      "keywords": ["converter", "markdown", "pdf", "mermaid", "data"],
      "strict": false
    },
    {
      "name": "k8s-troubleshooter",
      "source": "./plugins/k8s-troubleshooter",
      "description": "Diagnose Kubernetes alerts and warning events on Tim's OCI cluster — fetches alertmanager details, pulls relevant kubectl context, and proposes fixes",
      "version": "0.1.0",
      "author": {
        "name": "Timothy Liao",
        "email": "tim80411@gmail.com"
      },
      "repository": "https://github.com/tim80411/ai-agent-extension",
      "license": "MIT",
      "category": "ops",
      "keywords": ["kubernetes", "k8s", "alertmanager", "prometheus", "oci", "incident", "troubleshooting"],
      "strict": false
    },
    {
      "name": "workflow-lab",
      "source": "./plugins/workflow-lab",
      "description": "Park expensive multi-agent Workflow ideas as ready-to-run scripts, then pull one out and run it later behind a cost gate.",
      "version": "0.1.0",
      "author": {
        "name": "Timothy Liao",
        "email": "tim80411@gmail.com"
      },
      "repository": "https://github.com/tim80411/ai-agent-extension",
      "license": "MIT",
      "category": "productivity",
      "keywords": ["workflow", "multi-agent", "orchestration", "idea-park", "automation"],
      "strict": false
    },
    {
      "name": "pm-toolkit",
      "source": "./plugins/pm-toolkit",
      "description": "個人專案管理工具集：file-based-issues（檔案式／本地化 issue tracker 方法論）＋ spec-writing（Spec/Story 撰寫方法論，含 INVEST 檢查與反模式掃描）",
      "version": "0.2.0",
      "author": {
        "name": "Timothy Liao",
        "email": "tim80411@gmail.com"
      },
      "repository": "https://github.com/tim80411/ai-agent-extension",
      "license": "MIT",
      "category": "development",
      "keywords": ["project-management", "issue-tracker", "file-based", "spec", "user-story", "invest", "methodology", "建單", "需求單"],
      "strict": false
    }
